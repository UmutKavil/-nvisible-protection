[Unit]
Description=Guardian daily anomaly analysis
After=guardian-core.service

[Service]
Type=oneshot
User=guardian
Group=guardian
ExecStart=/opt/guardian/venv/bin/python3 /opt/guardian/scripts/anomaly_daily.py --config /opt/guardian/config/guardian.conf
MemoryMax=100M
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/opt/guardian/data
ReadWritePaths=/opt/guardian/logs/active /opt/guardian/logs/anomaly
