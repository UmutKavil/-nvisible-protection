[Unit]
Description=Invisible Protection network guardian
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=notify
User=root
WorkingDirectory=/opt/guardian/core
ExecStart=/opt/guardian/venv/bin/python3 /opt/guardian/core/sniffer.py --config /opt/guardian/config/guardian.conf
CPUAffinity=1 2
Restart=on-failure
Restart=always
RestartSec=10
RuntimeMaxSec=86400
MemoryMax=300M
MemorySwapMax=100M
WatchdogSec=60
NotifyAccess=main
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/guardian/logs/active
ReadWritePaths=/opt/guardian/data
ProtectHome=true

[Install]
WantedBy=multi-user.target
